# demo — самостоятельный просмотр; api — данные из Go-бэкенда.
VITE_DATA_SOURCE=demo

# Адрес назначения прокси Vite, используется только сервером разработки.
API_PROXY_TARGET=http://127.0.0.1:8080

# Для production при необходимости задаётся публичный адрес Go API.
# По умолчанию запросы идут на /api/v1 того же домена.
VITE_API_BASE_URL=/api/v1
